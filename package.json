    "@convex-dev/static-hosting": "0.2.1",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "ai": "7.0.109",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
