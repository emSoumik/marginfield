{
  "name": "marginfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4337",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "preview": "vite preview --host 127.0.0.1 --port 4337",
