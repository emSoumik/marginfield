# Browser-safe development deployment URL only. Never put API keys in VITE_*.
VITE_CONVEX_URL=
# CLI link set by Convex setup. This is not an API key.
CONVEX_DEPLOYMENT=

# Set these on the Convex server with its environment tooling, not in Vite:
# OPENAI_API_KEY
# OPENAI_MODEL (default: gpt-5-mini)
# FIRECRAWL_API_KEY
# FIRECRAWL_WEBHOOK_SECRET
# AGENTMAIL_API_KEY
# AGENTMAIL_WEBHOOK_SECRET
# ALLOWED_DIGEST_RECIPIENT (optional controlled demo recipient)
# SITE_URL
# JWT_PRIVATE_KEY and JWKS (generated by Convex Auth setup)
